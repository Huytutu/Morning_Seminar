```tool_code
import pandas as pd

try:
    # Load the data for Alpha 1
    excel_file_1 = pd.ExcelFile('13.xlsx')
    sheet_name_1 = excel_file_1.sheet_names[0]  # Assuming the relevant data is in the first sheet
    df_1 = pd.read_excel(excel_file_1, sheet_name=sheet_name_1)

    # Load the data for Alpha 2
    excel_file_2 = pd.ExcelFile('20.xlsx')
    sheet_name_2 = excel_file_2.sheet_names[0]  # Assuming the relevant data is in the first sheet
    df_2 = pd.read_excel(excel_file_2, sheet_name=sheet_name_2)

    # Assuming both DataFrames have a '净值日期' (Net Value Date) column
    # and columns for performance metrics.  Adapt the column names as necessary.
    df_1['净值日期'] = pd.to_datetime(df_1['净值日期'])
    df_2['净值日期'] = pd.to_datetime(df_2['净值日期'])

    # Ensure that the dataframes have the same date range
    start_date = max(df_1['净值日期'].min(), df_2['净值日期'].min())
    end_date = min(df_1['净值日期'].max(), df_2['净值日期'].max())

    df_1 = df_1[(df_1['净值日期'] >= start_date) & (df_1['净值日期'] <= end_date)].copy()
    df_2 = df_2[(df_2['净值日期'] >= start_date) & (df_2['净值日期'] <= end_date)].copy()

    df_1.set_index('净值日期', inplace=True)
    df_2.set_index('净值日期', inplace=True)

    #Calculate the return of the alpha index
    df_1['alpha1_return'] = df_1['指数'].pct_change()
    df_2['alpha2_return'] = df_2['指数'].pct_change()

    # Calculate cumulative returns, volatility, and Sharpe ratio for both Alphas
    cumulative_return_1 = (1 + df_1['alpha1_return']).cumprod()[-1]
    cumulative_return_2 = (1 + df_2['alpha2_return']).cumprod()[-1]

    # Annualize the volatility and Sharpe ratio (assuming daily data)
    annual_volatility_1 = df_1['alpha1_return'].std() * (252**0.5)
    annual_volatility_2 = df_2['alpha2_return'].std() * (252**0.5)

    sharpe_ratio_1 = df_1['alpha1_return'].mean() / df_1['alpha1_return'].std() * (252**0.5)
    sharpe_ratio_2 = df_2['alpha2_return'].mean() / df_2['alpha2_return'].std() * (252**0.5)

    # Compare the performance metrics
    print(f"Alpha 1 Cumulative Return: {cumulative_return_1:.4f}")
    print(f"Alpha 1 Annual Volatility: {annual_volatility_1:.4f}")
    print(f"Alpha 1 Sharpe Ratio: {sharpe_ratio_1:.4f}")

    print(f"Alpha 2 Cumulative Return: {cumulative_return_2:.4f}")
    print(f"Alpha 2 Annual Volatility: {annual_volatility_2:.4f}")
    print(f"Alpha 2 Sharpe Ratio: {sharpe_ratio_2:.4f}")

    if sharpe_ratio_1 > sharpe_ratio_2:
        better_alpha_index = 1
        reason = f"Alpha 1 has a higher Sharpe Ratio ({sharpe_ratio_1:.4f}) compared to Alpha 2 ({sharpe_ratio_2:.4f})."
    elif sharpe_ratio_2 > sharpe_ratio_1:
        better_alpha_index = 2
        reason = f"Alpha 2 has a higher Sharpe Ratio ({sharpe_ratio_2:.4f}) compared to Alpha 1 ({sharpe_ratio_1:.4f})."
    elif cumulative_return_1 > cumulative_return_2:
        better_alpha_index = 1
        reason = f"Alpha 1 has a higher Cumulative Return ({cumulative_return_1:.4f}) compared to Alpha 2 ({cumulative_return_2:.4f}), and the Sharpe Ratios are equal."
    else:
        better_alpha_index = 2
        reason = f"Alpha 2 has a higher Cumulative Return ({cumulative_return_2:.4f}) compared to Alpha 1 ({cumulative_return_1:.4f}), and the Sharpe Ratios are equal."


    print(f"\nThe better alpha index is: {better_alpha_index}")
    print(f"Reason: {reason}")

    submit_better_alpha_index(better_alpha_index, reason)


except Exception as e:
    print(f"An error occurred: {e}")
```
