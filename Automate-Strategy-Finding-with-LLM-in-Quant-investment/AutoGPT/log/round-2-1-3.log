import pandas as pd

# Load data for Alpha Index 1 (from 10.xlsx)
excel_file_1 = pd.ExcelFile("10.xlsx")
sheet_names_1 = excel_file_1.sheet_names
alpha1_data = {}
for sheet_name in sheet_names_1:
    df = pd.read_excel("10.xlsx", sheet_name=sheet_name)
    alpha1_data[sheet_name] = df

# Load data for Alpha Index 2 (from 13.xlsx)
excel_file_2 = pd.ExcelFile("13.xlsx")
sheet_names_2 = excel_file_2.sheet_names
alpha2_data = {}
for sheet_name in sheet_names_2:
    df = pd.read_excel("13.xlsx", sheet_name=sheet_name)
    alpha2_data[sheet_name] = df

# --- Comparison Logic ---
# Assuming the sheets represent different time periods or scenarios,
# we'll calculate the mean return for each Alpha across all sheets
# and compare them.  We'll also consider volatility if available.

alpha1_returns = []
alpha2_returns = []

for sheet_name in sheet_names_1:
    if '超额收益' in alpha1_data[sheet_name].columns:
        alpha1_returns.append(alpha1_data[sheet_name]['超额收益'].mean())
    else:
        alpha1_returns.append(alpha1_data[sheet_name].iloc[:, 1].mean()) # If there is no '超额收益' column, assume the second column represent the returns

for sheet_name in sheet_names_2:
    if '超额收益' in alpha2_data[sheet_name].columns:
        alpha2_returns.append(alpha2_data[sheet_name]['超额收益'].mean())
    else:
        alpha2_returns.append(alpha2_data[sheet_name].iloc[:, 1].mean()) # If there is no '超额收益' column, assume the second column represent the returns

mean_alpha1_return = sum(alpha1_returns) / len(alpha1_returns)
mean_alpha2_return = sum(alpha2_returns) / len(alpha2_returns)

print(f"Mean Return (Alpha Index 1): {mean_alpha1_return}")
print(f"Mean Return (Alpha Index 2): {mean_alpha2_return}")

# Determine which Alpha performs better
if mean_alpha2_return > mean_alpha1_return:
    better_alpha_index = 2
    reason = f"Alpha Index 2 has a higher mean return ({mean_alpha2_return:.4f}) compared to Alpha Index 1 ({mean_alpha1_return:.4f})."
else:
    better_alpha_index = 1
    reason = f"Alpha Index 1 has a higher mean return ({mean_alpha1_return:.4f}) compared to Alpha Index 2 ({mean_alpha2_return:.4f})."

print(f"Better Alpha Index: {better_alpha_index}")
print(f"Reason: {reason}")

