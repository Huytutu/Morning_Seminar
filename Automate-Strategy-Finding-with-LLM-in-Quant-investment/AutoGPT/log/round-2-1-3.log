```tool_code
import pandas as pd
import numpy as np

def analyze_alpha_performance(file1, file2):
    """
    Analyzes and compares the performance of two alphas based on data from two Excel files.

    Args:
        file1 (str): Path to the Excel file containing data for Alpha 1.
        file2 (str): Path to the Excel file containing data for Alpha 2.

    Returns:
        tuple: A tuple containing:
            - int: The index of the better-performing alpha (1 or 2).
            - str: A string containing the detailed performance comparison and justification.
    """

    try:
        # Read data from the Excel files
        alpha1_df = pd.read_excel(file1)
        alpha2_df = pd.read_excel(file2)

        # Attempt to infer the column containing return based on column name (hoping for "return" or "performance")
        return_col1 = None
        for col in alpha1_df.columns:
            if 'return' in col.lower() or 'performance' in col.lower():
                return_col1 = col
                break
        if return_col1 is None:
            # if cannot find the column containing returns, return error
            return -1, "Cannot find returns column in the first excel file."

        return_col2 = None
        for col in alpha2_df.columns:
            if 'return' in col.lower() or 'performance' in col.lower():
                return_col2 = col
                break
        if return_col2 is None:
            # if cannot find the column containing returns, return error
            return -1, "Cannot find returns column in the second excel file."

        alpha1_returns = alpha1_df[return_col1].dropna()
        alpha2_returns = alpha2_df[return_col2].dropna()

        # Convert returns to numeric, errors='coerce' will convert non-numeric entries to NaN
        alpha1_returns = pd.to_numeric(alpha1_returns, errors='coerce')
        alpha2_returns = pd.to_numeric(alpha2_returns, errors='coerce')

        # Drop NaNs resulting from the conversion
        alpha1_returns = alpha1_returns.dropna()
        alpha2_returns = alpha2_returns.dropna()

        # Calculate Performance Metrics
        total_return1 = alpha1_returns.sum()
        annualized_return1 = total_return1 * 4  # Assuming quarterly data
        volatility1 = alpha1_returns.std()
        sharpe_ratio1 = annualized_return1 / volatility1 if volatility1 > 0 else 0

        total_return2 = alpha2_returns.sum()
        annualized_return2 = total_return2 * 4  # Assuming quarterly data
        volatility2 = alpha2_returns.std()
        sharpe_ratio2 = annualized_return2 / volatility2 if volatility2 > 0 else 0

        # Compare and conclude
        if sharpe_ratio1 > sharpe_ratio2:
            better_alpha = 1
            reason = f"Alpha 1 (Sharpe Ratio: {sharpe_ratio1:.2f}) outperformed Alpha 2 (Sharpe Ratio: {sharpe_ratio2:.2f}) based on the Sharpe Ratio.  Alpha 1 also had an annualized return of {annualized_return1:.2f} and volatility of {volatility1:.2f}, compared to Alpha 2's annualized return of {annualized_return2:.2f} and volatility of {volatility2:.2f}."

        elif sharpe_ratio2 > sharpe_ratio1:
            better_alpha = 2
            reason = f"Alpha 2 (Sharpe Ratio: {sharpe_ratio2:.2f}) outperformed Alpha 1 (Sharpe Ratio: {sharpe_ratio1:.2f}) based on the Sharpe Ratio. Alpha 2 also had an annualized return of {annualized_return2:.2f} and volatility of {volatility2:.2f}, compared to Alpha 1's annualized return of {annualized_return1:.2f} and volatility of {volatility1:.2f}."

        else:
            better_alpha = 0  # Indicate a tie
            reason = "The alphas performed equally well based on the Sharpe Ratio."

        return better_alpha, reason

    except Exception as e:
        return -1, f"An error occurred: {e}"

# Call the analysis function
better_alpha_index, analysis_result = analyze_alpha_performance("10.xlsx", "13.xlsx")

print(f"The better performing alpha index: {better_alpha_index}")
print(f"Detailed analysis: {analysis_result}")


