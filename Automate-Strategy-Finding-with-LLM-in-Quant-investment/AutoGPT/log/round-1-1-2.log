import pandas as pd

def calculate_average_return(filename):
    """Calculates the average return of an Alpha across all sheets in an Excel file."""
    excel_file = pd.ExcelFile(filename)
    sheet_names = excel_file.sheet_names
    total_return = 0
    num_sheets = len(sheet_names)

    for sheet_name in sheet_names:
        df = pd.read_excel(filename, sheet_name=sheet_name)
        # Assuming the return is in a column named 'Return' or 'Returns'. Adapt if needed.
        if 'Return' in df.columns:
            return_column = 'Return'
        elif 'Returns' in df.columns:
            return_column = 'Returns'
        elif 'NAV_adj' in df.columns:  # Trying a different column
            return_column = 'NAV_adj'
        elif 'profit' in df.columns:  # Trying a different column
            return_column = 'profit'
        else:
            return None  # Unable to find suitable column
        
        total_return += df[return_column].mean()  # Assuming performance is in the 'Return' column

    if num_sheets > 0:
        average_return = total_return / num_sheets
    else:
        average_return = 0
    return average_return

# Calculate average returns for both Alphas
alpha1_average_return = calculate_average_return("10.xlsx")
alpha2_average_return = calculate_average_return("11.xlsx")

print(f"Alpha 1 Average Return: {alpha1_average_return}")
print(f"Alpha 2 Average Return: {alpha2_average_return}")

# Determine which Alpha performs better
if alpha1_average_return is None or alpha2_average_return is None:
    print("Unable to find a valid column for returns. Please check your column names.")
elif alpha1_average_return > alpha2_average_return:
    print("Alpha 1 performs better than Alpha 2.")
    better_alpha_index = 1
elif alpha2_average_return > alpha1_average_return:
    print("Alpha 2 performs better than Alpha 1.")
    better_alpha_index = 2
else:
    print("Alpha 1 and Alpha 2 perform equally well.")
    better_alpha_index = 0  #Assigning 0 arbitrarily in the case of a tie

# Prepare evidence

evidence = f"Based on the provided data, Alpha 1 has an average return of {alpha1_average_return} and Alpha 2 has an average return of {alpha2_average_return}. Therefore, Alpha {better_alpha_index} performs better."

if better_alpha_index == 0:
  evidence = "Based on the provided data, Alpha 1 has an average return of {alpha1_average_return} and Alpha 2 has an average return of {alpha2_average_return}. Therefore, Alpha 1 and Alpha 2 have the same performance"

if alpha1_average_return is None or alpha2_average_return is None:
    evidence = f"Unable to determine which alpha is better. Couldn't determine mean returns for one of the alpha files, as couldn't find the relevant return column."

# Submit the result
print(f"The better alpha index is {better_alpha_index}")
print(f"Evidence: {evidence}")
