```tool_code
import pandas as pd

def calculate_sharpe_ratio(df, risk_free_rate=0.0):
    """Calculates the Sharpe Ratio of a DataFrame of returns.

    Args:
        df (pd.DataFrame): DataFrame with a column named 'return'.
        risk_free_rate (float): Risk-free rate of return. Default is 0.0.

    Returns:
        float: Sharpe Ratio.
    """
    excess_returns = df['return'] - risk_free_rate
    sharpe_ratio = excess_returns.mean() / excess_returns.std()
    return sharpe_ratio

try:
    # Load the data for alpha factor 1 from '10.xlsx'
    df1 = pd.read_excel('10.xlsx')
    df1.rename(columns={'Unnamed: 0': 'date', 'Unnamed: 1': 'return'}, inplace=True)
    df1.drop(0, inplace=True)
    df1['return'] = pd.to_numeric(df1['return'], errors='coerce')
    df1.dropna(subset=['return'], inplace=True)

    # Load the data for alpha factor 2 from '11.xlsx'
    df2 = pd.read_excel('11.xlsx')
    df2.rename(columns={'Unnamed: 0': 'date', 'Unnamed: 1': 'return'}, inplace=True)
    df2.drop(0, inplace=True)
    df2['return'] = pd.to_numeric(df2['return'], errors='coerce')
    df2.dropna(subset=['return'], inplace=True)


    # Calculate Sharpe Ratios
    sharpe_ratio_1 = calculate_sharpe_ratio(df1)
    sharpe_ratio_2 = calculate_sharpe_ratio(df2)

    # Calculate Total Returns
    total_return_1 = df1['return'].sum()
    total_return_2 = df2['return'].sum()


    print(f"Sharpe Ratio for Alpha Factor 1: {sharpe_ratio_1:.4f}")
    print(f"Total Return for Alpha Factor 1: {total_return_1:.4f}")
    print(f"Sharpe Ratio for Alpha Factor 2: {sharpe_ratio_2:.4f}")
    print(f"Total Return for Alpha Factor 2: {total_return_2:.4f}")

    # Determine the better-performing alpha factor
    if sharpe_ratio_1 > sharpe_ratio_2:
        better_alpha_index = 1
        print("Alpha Factor 1 performs better based on Sharpe Ratio.")
    elif sharpe_ratio_2 > sharpe_ratio_1:
        better_alpha_index = 2
        print("Alpha Factor 2 performs better based on Sharpe Ratio.")
    else:
        better_alpha_index = 1  # Arbitrarily choose 1 if they are equal. Total Return will decide.
        if total_return_2 > total_return_1:
            better_alpha_index = 2
        print("Alpha Factors have equal Sharpe Ratios. Break tie using Total Return.")

    # Prepare the submit_better_alpha_index output
    output = f"Based on Sharpe Ratio, Alpha Factor {better_alpha_index} is better."

    if better_alpha_index == 1:
         output += f"  Sharpe Ratio 1: {sharpe_ratio_1:.4f}, Total Return 1: {total_return_1:.4f}  Sharpe Ratio 2: {sharpe_ratio_2:.4f}, Total Return 2: {total_return_2:.4f}"
    else:
        output += f"  Sharpe Ratio 1: {sharpe_ratio_1:.4f}, Total Return 1: {total_return_1:.4f}  Sharpe Ratio 2: {sharpe_ratio_2:.4f}, Total Return 2: {total_return_2:.4f}"

    print(output)

except Exception as e:
    print(f"An error occurred: {e}")
